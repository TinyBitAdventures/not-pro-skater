; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Not Pro Skater"
config/description="A skateboarding game about everyone else: community events, real parks, real crashes."
run/main_scene="res://scenes/title.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/version="0.1.0"
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.067, 0.078, 0.106, 1)
boot_splash/show_image=false

[autoload]

Controls="*res://scripts/autoload/controls.gd"
Game="*res://scripts/autoload/game.gd"
Sound="*res://scripts/autoload/sound.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="skater"

[physics]

3d/physics_engine="Jolt Physics"

common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=8

[rendering]

textures/default_filters/anisotropic_filtering_level=4

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.56, 0.83, 1, 1)
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=4

[importer_defaults]

texture={
"compress/mode": 2,
"detect_3d/compress_to": 1,
"mipmaps/generate": true
}
